# Deploy target for the shared GKE cluster. Copy to shared.env (git-ignored) and fill in:
#   cp environments/shared.env.example environments/shared.env
# No secrets here (those go in ../.env). Every value can be overridden from the shell, e.g.:
#   BACKEND_NAMESPACE=nilam-ocr-test ./deploy.sh ocr-backend ec05d54 --env shared

# GKE cluster. The control plane has only a private endpoint, open to the bastion subnet, so the scripts
# reach it through an IAP SSH tunnel to the bastion. Leave GKE_BASTION empty for a public control plane.
GKE_PROJECT=<gcp-project-id>
GKE_REGION=asia-southeast2
GKE_CLUSTER=<gke-cluster-name>
GKE_BASTION=<bastion-vm-name>
GKE_BASTION_ZONE=asia-southeast2-a
# GKE_BASTION_PROJECT=<project of the bastion, default GKE_PROJECT>

# Nexus: images live at $NEXUS_REGISTRY/$NEXUS_PATH/<image>:<tag>
NEXUS_REGISTRY=<nexus-host>
NEXUS_PATH=bribrain/dev/nilam/nilam-ocr-orchestrator
PULL_SECRET=nexus-pull-secret

# OCR backend (api + worker)
BACKEND_RELEASE=ocr-backend
BACKEND_NAMESPACE=nilam
BACKEND_IMAGE=ms-bribrain-nilam-ocr-orchestrator
BACKEND_SECRET=ocr-orchestration

# Redis shared by every team on this cluster, one ACL user per team (`scripts/services/redis/user.sh`).
REDIS_RELEASE=shared-redis
REDIS_NAMESPACE=shared-redis
REDIS_IMAGE=redis
REDIS_SECRET=shared-redis-acl

# RBAC admin UI
RBAC_UI_RELEASE=ocr-rbac-ui
RBAC_UI_NAMESPACE=nilam
RBAC_UI_IMAGE=mf-bribrain-nilam-ocr-admin-ui

# NILAM OCR akta: five services, one chart (charts/ocr-akta), one release each ($AKTA_RELEASE_PREFIX-<service>),
# image $NEXUS_REGISTRY/$AKTA_NEXUS_PATH/$AKTA_IMAGE_PREFIX-<service>:<tag>. Its own Nexus folder, not NEXUS_PATH.
AKTA_RELEASE_PREFIX=ocr-akta
AKTA_NAMESPACE=bribrain-ocr-nilam
AKTA_NEXUS_PATH=bribrain/dev/nilam-ocr-akta
AKTA_IMAGE_PREFIX=ms-bribrain-nilam-ocr-akta
AKTA_SECRET=nilam-ocr-akta-secrets

# Bedrock connectivity probe (shared cluster only)
BEDROCK_RELEASE=bedrock-probe
BEDROCK_NAMESPACE=nilam
BEDROCK_IMAGE=ms-bribrain-nilam-ocr-orchestrator
BEDROCK_SECRET=bedrock-probe-credentials
