# Deploy target for the dev environment. Copy to dev.env (git-ignored) and fill in:
#   cp environments/dev.env.example environments/dev.env
# No secrets here (those go in ../.env). Every value can be overridden from the shell, e.g.:
#   GKE_PROJECT=other-project BACKEND_NAMESPACE=ocr-test ./deploy.sh ocr-backend ec05d54

# GKE cluster
GKE_PROJECT=<gcp-project-id>
GKE_REGION=asia-southeast2
GKE_CLUSTER=<gke-cluster-name>

# Nexus: images live at $NEXUS_REGISTRY/$NEXUS_PATH/<image>:<tag>
NEXUS_REGISTRY=<nexus-host>
NEXUS_PATH=bribrain/dev/nilam/nilam-ocr-orchestrator
PULL_SECRET=nexus-pull-secret

# OCR backend (api + worker)
BACKEND_RELEASE=ocr-backend
BACKEND_NAMESPACE=ocr-orchestration
BACKEND_IMAGE=ms-bribrain-nilam-ocr-orchestrator
BACKEND_SECRET=ocr-orchestration

# RBAC admin UI
RBAC_UI_RELEASE=ocr-rbac-ui
RBAC_UI_NAMESPACE=ocr-orchestration
RBAC_UI_IMAGE=mf-bribrain-nilam-ocr-admin-ui

# NILAM OCR akta: five services, one chart (charts/ocr-akta), one release each ($AKTA_RELEASE_PREFIX-<service>),
# image $NEXUS_REGISTRY/$AKTA_NEXUS_PATH/$AKTA_IMAGE_PREFIX-<service>:<tag>. Its own Nexus folder, not NEXUS_PATH.
AKTA_RELEASE_PREFIX=ocr-akta
AKTA_NAMESPACE=nilam-ocr-akta
AKTA_NEXUS_PATH=bribrain/dev/nilam-ocr-akta
AKTA_IMAGE_PREFIX=ms-bribrain-nilam-ocr-akta
AKTA_SECRET=nilam-ocr-akta-secrets
